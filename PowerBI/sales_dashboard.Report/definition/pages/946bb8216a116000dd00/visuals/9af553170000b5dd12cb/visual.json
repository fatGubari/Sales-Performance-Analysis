            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Sales: sales have been increasing compare to the beginning of 2014. The sales was at the highest peak in the November 2017. The months in which revenue increased the most are 11, 12, 9 of each year.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Products: each category of products contains products with high sales but low profitability. Certain heavy-duty printers in Technology and bulky conference tables in Furniture generate high revenue but suffer from negative margins due to shipping and discounting costs For the office supplies(BoxOffice By Design Rectangular and Half-Moon ...)",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Region: the west region contribute in sales more than other regions with almost $253k and second the east region with $208k.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Discount: high discount may affect the profitability specially with 30% or higher profitability will become negative.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "customers: a significant amount of consumers play a big role in sales with 50.56% of consumers are these a good business insights for my dashboard ",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
